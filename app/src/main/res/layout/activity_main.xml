            <TextView
                android:id="@+id/tv_main_version"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textColor="@color/md_on_surface_variant"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:padding="8dp"
                        android:background="@drawable/bg_nav_pill_active"
                        android:src="@drawable/ic_recon"
                        android:tint="@color/md_on_secondary_container"
                        android:contentDescription="@string/dilink2_name"/>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/dilink2_name"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="@color/md_on_surface"/>
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/hub_dl2_desc"
                            android:textSize="12sp"
                            android:textColor="@color/md_on_surface_variant"/>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_dl3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

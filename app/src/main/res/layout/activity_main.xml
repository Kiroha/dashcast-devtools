<?xml version="1.0" encoding="utf-8"?>
<!-- DashCast DevTools — Main hub.
     Layout copied from DashCast (MyBYDApp) Material 3 redesign:
     left NavRail (96dp) with pill-shaped active item, right hero area with
     module cards. Logo long-press opens the overflow menu (also accessible
     via the 3-dots icon at the bottom of the rail). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:baselineAligned="false"
    android:orientation="horizontal"
    android:background="@color/md_background"
    tools:ignore="HardcodedText">

    <!-- ════════ NAV RAIL ════════ -->
    <LinearLayout
        android:id="@+id/ll_nav_rail"
        android:layout_width="96dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/md_surface_container_low"
        android:paddingTop="20dp"
        android:paddingBottom="16dp">

        <ImageView
            android:id="@+id/iv_nav_logo"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="24dp"
            android:scaleType="fitCenter"
            android:src="@mipmap/ic_launcher"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/app_name"/>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:scrollbars="none"
            android:overScrollMode="never">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/nav_sniffer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?android:attr/selectableItemBackground">
                    <ImageView
                        android:layout_width="56dp"
                        android:layout_height="32dp"
                        android:padding="4dp"
                        android:scaleType="fitCenter"
                        android:tint="@color/md_on_secondary_container"
                        android:background="@drawable/bg_nav_pill_active"
                        android:src="@drawable/ic_sniffer"
                        android:contentDescription="@string/main_btn_sniffer"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/nav_sniffer"
                        android:textSize="11sp"
                        android:textColor="@color/md_on_surface"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/nav_dl2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?android:attr/selectableItemBackground">
                    <ImageView
                        android:layout_width="56dp"
                        android:layout_height="32dp"
                        android:padding="4dp"
                        android:scaleType="fitCenter"
                        android:tint="@color/md_on_surface_variant"
                        android:src="@drawable/ic_recon"
                        android:contentDescription="@string/dilink2_name"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/nav_dl2"
                        android:textSize="11sp"
                        android:textColor="@color/md_on_surface_variant"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/nav_dl3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?android:attr/selectableItemBackground">
                    <ImageView
                        android:layout_width="56dp"
                        android:layout_height="32dp"
                        android:padding="4dp"
                        android:scaleType="fitCenter"
                        android:tint="@color/md_on_surface_variant"
                        android:src="@drawable/ic_recon"
                        android:contentDescription="@string/dilink3_name"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/nav_dl3"
                        android:textSize="11sp"
                        android:textColor="@color/md_on_surface_variant"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/nav_dl4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?android:attr/selectableItemBackground">
                    <ImageView
                        android:layout_width="56dp"
                        android:layout_height="32dp"
                        android:padding="4dp"
                        android:scaleType="fitCenter"
                        android:tint="@color/md_on_surface_variant"
                        android:src="@drawable/ic_recon"
                        android:contentDescription="@string/dilink4_name"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/nav_dl4"
                        android:textSize="11sp"
                        android:textColor="@color/md_on_surface_variant"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/nav_dl50"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?android:attr/selectableItemBackground">
                    <ImageView
                        android:layout_width="56dp"
                        android:layout_height="32dp"
                        android:padding="4dp"
                        android:scaleType="fitCenter"
                        android:tint="@color/md_on_surface_variant"
                        android:src="@drawable/ic_fission"
                        android:contentDescription="@string/dilink50_name"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/nav_dl50"
                        android:textSize="11sp"
                        android:textColor="@color/md_on_surface_variant"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/nav_dl51"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?android:attr/selectableItemBackground">
                    <ImageView
                        android:layout_width="56dp"
                        android:layout_height="32dp"
                        android:padding="4dp"
                        android:scaleType="fitCenter"
                        android:tint="@color/md_on_surface_variant"
                        android:src="@drawable/ic_fission"
                        android:contentDescription="@string/dilink51_name"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/nav_dl51"
                        android:textSize="11sp"
                        android:textColor="@color/md_on_surface_variant"/>
                </LinearLayout>

            </LinearLayout>
        </ScrollView>

        <ImageView
            android:id="@+id/nav_overflow"
            android:layout_width="56dp"
            android:layout_height="40dp"
            android:layout_gravity="center_horizontal"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:tint="@color/md_on_surface_variant"
            android:src="@drawable/ic_more_vert"
            android:clickable="true"
            android:focusable="true"
            android:background="?android:attr/selectableItemBackground"
            android:contentDescription="@string/menu_overflow"/>
    </LinearLayout>

    <!-- ════════ MAIN PANE ════════ -->
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:padding="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="@color/md_on_background"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/main_subtitle"
                android:textSize="14sp"
                android:textColor="@color/md_on_surface_variant"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="24dp"/>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_sniffer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="@color/md_surface_container"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="16dp"
                    android:gravity="center_vertical">
                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:padding="8dp"
                        android:background="@drawable/bg_nav_pill_active"
                        android:src="@drawable/ic_sniffer"
                        android:tint="@color/md_on_secondary_container"
                        android:contentDescription="@string/main_btn_sniffer"/>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/main_btn_sniffer"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="@color/md_on_surface"/>
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/hub_sniffer_desc"
                            android:textSize="12sp"
                            android:textColor="@color/md_on_surface_variant"/>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_dl2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="@color/md_surface_container"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground">
                <LinearLayout
                    android:layout_width="match_parent"

<?xml version="1.0" encoding="utf-8"?>
<!--
  activity_dilink3.xml — DiLink 3 diagnostic activity.
  Tab 0 : "8.8 Screen" (Dl3ScreenRunner)
  Tab 1 : "Recon"      (Dl3ReconRunner — 25 tests App+ADB)
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?android:attr/windowBackground">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:title="@string/dilink3_name"
        app:navigationIcon="?attr/homeAsUpIndicator"
        style="@style/Widget.MaterialComponents.Toolbar.Primary"/>

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabs_dl3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:tabMode="fixed"
        app:tabGravity="fill"
        app:tabSelectedTextColor="@color/md_primary"
        app:tabTextColor="@color/md_on_surface_variant"
        app:tabIndicatorColor="@color/md_primary"
        app:tabRippleColor="@color/md_primary"
        android:background="@color/md_surface_container"/>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- ── Panel 8.8 Screen ─────────────────────────────────────────── -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/panel_screen88"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <!-- Header card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    app:cardCornerRadius="20dp"
                    app:cardBackgroundColor="@color/md_surface_container_low"
                    app:contentPaddingTop="20dp"
                    app:contentPaddingBottom="20dp"
                    app:contentPaddingLeft="20dp"
                    app:contentPaddingRight="20dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <!-- Title row -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="12dp">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/diag_dl3_screen88_title"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                android:textColor="?android:attr/textColorPrimary"/>

                            <TextView
                                android:id="@+id/tv_screen88_subtitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="12sp"
                                android:textColor="@color/md_on_surface_variant"
                                android:text="…"/>
                        </LinearLayout>

                        <!-- Pill + counters row -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="16dp">

                            <TextView
                                android:id="@+id/tv_screen88_pill"
                                android:layout_width="wrap_content"
                                android:layout_height="36dp"
                                android:gravity="center"
                                android:paddingStart="12dp"
                                android:paddingEnd="12dp"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:textColor="?android:attr/textColorPrimary"
                                android:background="@drawable/bg_test_pill"
                                android:text="@string/diag_dl3_pill_unknown"/>

                            <TextView
                                android:id="@+id/tv_screen88_counters"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:textSize="12sp"
                                android:textColor="@color/md_on_surface_variant"
                                android:text="@string/diag_counters_idle"/>
                        </LinearLayout>

                        <!-- Buttons row -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_screen88_run_all"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/diag_run_all"/>

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_screen88_copy_report"
                                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:text="@string/diag_copy_report"/>
                        </LinearLayout>

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Test list -->
                <LinearLayout
                    android:id="@+id/ll_screen88_test_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"/>

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- ── Panel Recon ──────────────────────────────────────────────── -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/panel_recon"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <!-- Header card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    app:cardCornerRadius="20dp"
                    app:cardBackgroundColor="@color/md_surface_container_low"
                    app:contentPaddingTop="20dp"
                    app:contentPaddingBottom="20dp"
                    app:contentPaddingLeft="20dp"
                    app:contentPaddingRight="20dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <!-- Title row -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="12dp">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/diag_dl3_recon_title"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                android:textColor="?android:attr/textColorPrimary"/>

                            <TextView
                                android:id="@+id/tv_recon3_subtitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="12sp"
                                android:textColor="@color/md_on_surface_variant"
                                android:text="…"/>
                        </LinearLayout>

                        <!-- Info banner -->
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp"
                            android:text="@string/diag_dl3_recon_info"
                            android:textSize="11sp"
                            android:textColor="@color/md_on_surface_variant"/>

                        <!-- Pill + counters row -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="16dp">

                            <TextView
                                android:id="@+id/tv_recon3_pill"
                                android:layout_width="wrap_content"
                                android:layout_height="36dp"
                                android:gravity="center"
                                android:paddingStart="12dp"
                                android:paddingEnd="12dp"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:textColor="?android:attr/textColorPrimary"
                                android:background="@drawable/bg_test_pill"
                                android:text="@string/diag_dl3_pill_unknown"/>

                            <TextView
                                android:id="@+id/tv_recon3_counters"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:textSize="12sp"
                                android:textColor="@color/md_on_surface_variant"
                                android:text="@string/diag_counters_idle"/>
                        </LinearLayout>

                        <!-- Buttons row -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_recon3_run_all"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/diag_run_all"/>

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_recon3_share"
                                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:text="@string/diag_btn_share"/>
                        </LinearLayout>

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Test list -->
                <LinearLayout
                    android:id="@+id/ll_recon3_test_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"/>

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

    </FrameLayout>

</LinearLayout>
